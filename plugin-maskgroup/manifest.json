{
  "manifestVersion": 5,
  "apiVersion": 2,
  "id": "com.niiya.mask-groups",
  "name": "Lrマスク",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "maskGroupPanel",
      "label": {
        "default": "Lrマスク"
